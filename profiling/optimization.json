  "audit_dispositions": [
    {
      "id": "F01",
      "status": "implemented",
      "evidence": "QC defers table serialization; native JSON encoder retains parsed output."
    },
    {
      "id": "F02",
      "status": "implemented",
      "evidence": "Version/factory/parameter producer LRU and per-key flights reuse overlapping specs."
    },
    {
      "id": "F03",
      "status": "implemented",
      "evidence": "Column-major pool, smaller FFT chunks and exact batched AUC group counts reduce transient memory."
    },
    {
      "id": "F04",
      "status": "implemented",
      "evidence": "One research process, two admitted research requests, bounded HTTP threads, deadlines and socket inactivity timeout."
    },
    {
      "id": "F05",
      "status": "improved; mathematical cost remains",
      "evidence": "Exact counted ranks avoid repeated bootstrap sorting; pairwise mutual information still scales quadratically."
    },
    {
      "id": "F06",
      "status": "implemented",
      "evidence": "Atomic uncompressed IPC caches replace live Parquet round-trips; offline legacy fallback remains."
    },
    {
      "id": "F07",
      "status": "improved; correctness work remains",
      "evidence": "Fast IPC refresh and independent content versions; full changed histories are still checked for corrections."
    },
    {
      "id": "F08",
      "status": "implemented",
      "evidence": "Keyed raw/result/producer flights avoid duplicate initial loads and unrelated spec queues."
    },
    {
      "id": "F09",
      "status": "implemented",
      "evidence": "Byte LRUs, bounded key lifetimes, gradual QC eviction; resumable disk pools have a 2 GiB LRU and use memory maps."
    },
    {
      "id": "F10",
      "status": "improved; dependency cost remains",
      "evidence": "No import-time QC compilation in HTTP process; Numba caches compiled kernels. Pinned Limen still dominates imports."
    },
    {
      "id": "F11",
      "status": "upstream ticket",
      "evidence": "Indicator internals are tracked independently in Vaquum/Limen#930."
    },
    {
      "id": "F12",
      "status": "preserved for numerical correctness",
      "evidence": "Date selection stays after complete-history indicators and target calculation. Lazy JSON and producer reuse reduce its cost."
    },
    {
      "id": "F13",
      "status": "no change warranted",
      "evidence": "Targets and grading remain minor measured costs."
    },
    {
      "id": "F14",
      "status": "inherent enumeration cost",
      "evidence": "Subset enumeration remains combinatorial; reusable primitives keep individual assembly cheap."
    },
    {
      "id": "F15",
      "status": "bounded exact computation retained",
      "evidence": "Context ranks and exact circular-shift preparation still recompute per search. Their work is isolated and allocations are batched."
    },
    {
      "id": "F16",
      "status": "improved; production capacity unmeasured",
      "evidence": "Exact regression tests, bounded validation and retained matched timings added; short HTTP batches do not establish production p99 or saturation capacity."
    }
  ],
  "method": {
    "hardware": "Apple M1 Max, 10 logical CPUs, 64 GiB",
    "python": "3.13.2",
    "threads": "Polars=4, Numba=4, BLAS=1",
    "scope": "Identical full cached snapshots, 20,784 hourly and 83,136 fifteen-minute bars; no history truncation. 30 QC factories produce 31 features and 465 pairs.",
    "discovery": "83k search kernels use one immutable recorded 259-column pool, built by the after engine; both pool and discovery digests match. Catalog build is separate because combined baseline runs exceeded 49 seconds.",
    "samples": "Cold operations and 83k discovery are single samples; repeated operations use medians. Failed/tradeoff trials are retained separately. Measurements span implementation commits recorded in each file.",
    "memory": "High-water RSS of the complete measurement process including imports, full input decoding, fixtures and transients. Not incremental allocation or total service RSS across processes.",
    "load": "Shared-host contention was substantial and variable, reaching load averages above 50 on ten CPUs. CPU samples and host load are recorded in later measurements. No production Linux timing claim.",
    "mixed_http": "Latest data p95 during QC regressed from 19.8479587 to 22.71405275 ms. Earlier run improved; no stable gain is claimed. Worker isolation and overload availability are regression-tested."
  },
  "remaining": [
    "Limen indicator Python loops and eager dependency imports",
    "Cold quadratic pairwise statistics",
    "Full-context ranks and exact circular-shift work",
    "Python row materialization for JSON",
    "Production saturation, WAN and p99 measurements"
  ],
